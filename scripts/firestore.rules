rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isEditorOrAdmin() {
      return request.auth != null && currentUserRole() in ['editor', 'admin'];
    }

    function isAdmin() {
      return request.auth != null && currentUserRole() == 'admin';
    }

    // Users collection - users can read their own document, admins can read all
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        // User can write to their own document
        request.auth.uid == userId ||
        // Or user is an admin
        isAdmin()
      );
    }
    
    // Groups collection - authenticated users can read, only editors and admins can write
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if isEditorOrAdmin();
      allow update, delete: if request.auth != null && (
        // Owner can edit their own groups
        resource.data.ownerId == request.auth.uid ||
        // Editors and admins can manage content
        isEditorOrAdmin()
      );
    }
    
    // Stacks (pinkkas) collection - authenticated users can read, only editors and admins can write
    match /stacks/{stackId} {
      allow read: if request.auth != null;
      allow create: if isEditorOrAdmin();
      allow update, delete: if request.auth != null && (
        // Owner can edit their own stacks
        resource.data.ownerId == request.auth.uid ||
        // Editors and admins can manage content
        isEditorOrAdmin()
      );
    }

    // Hierarchical stacks under groups
    match /groups/{groupId}/stacks/{stackId} {
      allow read: if request.auth != null;
      allow create: if isEditorOrAdmin();
      allow update, delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        isEditorOrAdmin()
      );
    }
    
    // Canonical learning-item collection - authenticated users can read, only editors and admins can write
    match /learning-items/{learningItemId} {
      allow read: if request.auth != null;
      allow create: if isEditorOrAdmin();
      allow update, delete: if request.auth != null && (
        // Owner can edit their own learning items
        resource.data.ownerId == request.auth.uid ||
        // Editors and admins can manage content
        isEditorOrAdmin()
      );
    }

    // Legacy canonical species collection kept readable/writable during migration.
    match /species/{speciesId} {
      allow read: if request.auth != null;
      allow create: if isEditorOrAdmin();
      allow update, delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        isEditorOrAdmin()
      );
    }

    // Hierarchical species under groups/{groupId}/stacks/{stackId}
    match /groups/{groupId}/stacks/{stackId}/species/{speciesId} {
      allow read: if request.auth != null;
      allow create: if isEditorOrAdmin();
      allow update, delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        isEditorOrAdmin()
      );
    }

    // Pinkka hierarchy collection - authenticated users can read,
    // only editors and admins can write.
    match /pinkka/{document=**} {
      allow read: if request.auth != null;
      allow write: if isEditorOrAdmin();
    }

    // Backend Pinkka import jobs - admins enqueue and can request interruption
    // for their own jobs; functions write server-side progress and terminal
    // state updates with admin privileges.
    match /pinkkaImportJobs/{jobId} {
      allow read: if isEditorOrAdmin() || (
        request.auth != null &&
        resource.data.requesterId == request.auth.uid
      );
      allow create: if isEditorOrAdmin() &&
        request.resource.data.requesterId == request.auth.uid;
      allow update: if request.auth != null &&
        (
          isEditorOrAdmin() ||
          (
            resource.data.requesterId == request.auth.uid &&
            request.resource.data.requesterId == resource.data.requesterId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'interruptRequestedAt',
              'acknowledgedAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Learning progress collection - users can read/write their own progress
    match /learningProgress/{progressId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Stack learning histograms - users can read/write their own summaries
    match /stackLearningHistograms/{histogramId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Stack scientific progress - users can read their own cached summaries
    match /stackScientificProgress/{progressId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Group scientific progress - users can read their own cached summaries
    match /groupScientificProgress/{progressId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Global scientific progress - users can read their own cached summary
    match /globalScientificProgress/{progressId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Scope totals are server-maintained and not exposed to clients directly.
    match /stackScientificScopeTotals/{scopeId} {
      allow read, write: if false;
    }

    match /groupScientificScopeTotals/{scopeId} {
      allow read, write: if false;
    }

    match /globalScientificScopeTotals/{scopeId} {
      allow read, write: if false;
    }
  }
}
