rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can read their own document, admins can read all
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        // User can write to their own document
        request.auth.uid == userId ||
        // Or user is an admin
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Groups collection - authenticated users can read, only editors and admins can write
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin'];
      allow update, delete: if request.auth != null && (
        // Owner can edit their own groups
        resource.data.ownerId == request.auth.uid ||
        // Or user is an admin
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Stacks (pinkkas) collection - authenticated users can read, only editors and admins can write
    match /stacks/{stackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin'];
      allow update, delete: if request.auth != null && (
        // Owner can edit their own stacks
        resource.data.ownerId == request.auth.uid ||
        // Or user is an admin
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Species collection - authenticated users can read, only editors and admins can write
    match /species/{speciesId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin'];
      allow update, delete: if request.auth != null && (
        // Owner can edit their own species
        resource.data.ownerId == request.auth.uid ||
        // Or user is an admin
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Pinkka hierarchy collection - authenticated users can read,
    // only editors and admins can write.
    match /pinkka/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin'];
    }

    // Learning progress collection - users can read/write their own progress
    match /learningProgress/{progressId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Stack learning histograms - users can read/write their own summaries
    match /stackLearningHistograms/{histogramId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
  }
}
