    {
      "title": {
        "fi": "Elinympäristö",
        "sv": "Habitat",
        "en": "Habitat"
      },
      "body": {
        "fi": "Viljelyperäinen, leviää luonnossa (koriste- ja harvoin viljelymetsäpuu).",
        "sv": "<p>Mellersta- och hemiboreal, friska och näringsrika barrskog; kalkgynnad. Något kontinental–kontinental. </p>"
      },
