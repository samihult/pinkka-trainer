    "sv": "pichtagran",
    "fi": "siperianpihta"
  },
  "scientificName": "Abies sibirica",
  "distributionMapFinland": null,
  "alternativeVernacularNames": {},
  "description": [
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "Ainavihanta havupuu, latvus tiheä, kapean kartiomainen."
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {
        "fi": "8–20 m."
      },
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "Runko harmaa; kuori sileä, pihkarakkulainen. Talvisilmut munanmuotoiset, pihkaiset, harmaat."
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "Neulaset sivulle ja haaranmyötäisesti siirottavia, haararangan peittäviä, yksittäin, 20–30 x 1 mm, päältä tummanvihreitä, neulasen kärkiosan päällä tavallisesti ilmarakoja; alapinnalla kaksi valkeaa ilmarakojuovaa, neulasen kärki lantto. Neulasarpi pyöreä, ei koholla."
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Juuri",
        "sv": "Rot",
        "en": "Root"
      },
      "body": {},
      "predicate": "MX.descriptionRoot"
    },
    {
      "title": {
        "fi": "Kukka",
        "sv": "Blomma",
        "en": "Flower"
      },
      "body": {},
      "predicate": "MX.descriptionFlower"
    },
    {
      "title": {
        "fi": "Käpy",
        "sv": "Kotte",
        "en": "Cone"
      },
      "body": {
        "fi": "<p>Käpy 5–8 x 2–4 cm, pysty, pitkänomainen, kukintavuoden syksynä kypsyvä; käpysuomut kävyn kypsyessä irtoavia; pysty käpyranka jää kiinni oksaan.</p>"
      },
      "predicate": "MX.descriptionCone"
    },
    {
      "title": {
