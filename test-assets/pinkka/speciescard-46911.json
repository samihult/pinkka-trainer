{
  "taxonId": "MX.37788",
  "vernacularName": {
    "sv": "grönbräken",
    "fi": "viherraunioinen"
  },
  "scientificName": "Asplenium viride",
  "distributionMapFinland": null,
  "alternativeVernacularNames": {},
  "description": [
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "<p>Pieni saniainen.</p>"
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {
        "fi": "<p>5–20 cm.</p>"
      },
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "<p>Maavarsi lyhyt ja tummasuomuinen.</p>"
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Lehtilapa tasasoukka ja parilehdykkäinen. Lehtiruoti pääosin vihreä, vain tyvestä tummanruskea. Lehdykät 4–10 mm pitkät, tiheässä, kapeatyviset, vaaleanvihreät ja laidoiltaan usein alaskääntyneet. Lehdet lakastuvat syksyllä.</p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Juuri",
        "sv": "Rot",
        "en": "Root"
      },
      "body": {},
      "predicate": "MX.descriptionRoot"
    },
    {
      "title": {
        "fi": "Itiöpesäkkeet",
        "sv": "Sporangium",
        "en": "Sporangium"
      },
      "body": {
        "fi": "<p>Itiöpesäkeryhmät lehtien alapinnalla, pyöreitä. Katesuomu vähäinen tai puuttuu. Itiöt tummanruskeita.</p>"
      },
      "predicate": "MX.descriptionSporangiumAndAsexualReproduction"
    },
    {
      "title": {
        "fi": "Itiöt",
        "sv": "Sporer",
        "en": "Spores"
      },
      "body": {},
      "predicate": "MX.descriptionSpore"
    },
    {
      "title": {
        "fi": "Elinympäristö",
        "sv": "Habitat",
        "en": "Habitat"
      },
      "body": {
        "fi": "<p>Kalkkipitoisilla tai ultraemäksisillä kallioilla, soraikoilla ja kallionraoissa.</p>"
      },
      "predicate": "MX.habitat"
    },
    {
      "title": {
        "fi": "Kasvualusta",
        "sv": "Växtunderlag",
        "en": "Substrate"
      },
      "body": {},
      "predicate": "MX.habitatSubstrate"
    },
    {
      "title": {
        "fi": "Levinneisyys Suomessa",
        "sv": "Utbredning i Finland",
        "en": "Distribution in Finland"
      },
      "body": {
        "fi": "<p>Vakinainen alkuperäinen. Yleisin Tunturi-Lapissa, Oulun eteläpuolella itäinen.</p>"
      },
      "predicate": "MX.distributionFinland"
    },
    {
      "title": {
