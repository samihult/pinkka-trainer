    {
      "title": {
        "fi": "Lisätiedot",
        "sv": "Tilläggsuppgifter",
        "en": "Additional information"
      },
      "body": {
        "fi": "<p>Hyvin myrkyllinen. Puna- ja mustakonnanmarjan (A. spicata) risteytymä harvinainen kantalajien yhteisillä kasvupaikoilla.</p>"
      },
      "predicate": "MX.miscText"
