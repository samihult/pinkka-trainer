{
  "taxonId": "MX.37860",
  "vernacularName": {
    "sv": "röd trolldruva",
    "fi": "punakonnanmarja"
  },
  "scientificName": "Actaea erythrocarpa",
  "distributionMapFinland": null,
  "alternativeVernacularNames": {},
  "description": [
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "<p>Monivuotinen ruoho.</p>"
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {
        "fi": "<p>20–50 cm korkea.</p>"
      },
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "<p>Juurakko on lyhyt, viisto ja puutunut. Varsi on pysty.</p>"
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Juuri",
        "sv": "Rot",
        "en": "Root"
      },
      "body": {},
      "predicate": "MX.descriptionRoot"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Tyvilehdet pitkäruotisia ja isoja, lapa leveän kolmiomainen, tavallisesti 4–5 kertaa sormilehdykkäinen. Varsilehdet ovat pienempiä, vähemmän kerrannaisia ja lyhytruotisia. Lehdykät ovat puikeita, suippoja ja hampaisia. Kärkilehdykkä on tavallisesti tylppä- tai suippotyvinen, keskiliuska sivuliuskoja ja kärkihammas laidan hampaita selvästi pitempi.</p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Kukka",
        "sv": "Blomma",
        "en": "Flower"
      },
      "body": {
        "fi": "<p>Kukinto on tiheä, lyhyt, pysty terttu, jonka alapuolella usein pari yksittäistä kukkaa. Kukat ovat pieniä, valkoisia tai punertavia ja tuoksuttomia. Terälehtiä on 0–2 ja ne varisevat varhain.</p>"
      },
      "predicate": "MX.descriptionFlower"
    },
    {
      "title": {
        "fi": "Kukinta-aika",
        "sv": "Blomningstid",
        "en": "Flowering time"
      },
      "body": {
        "fi": "<p>Kukkii keskikesällä (VI).</p>"
      },
      "predicate": "MX.reproductionFloweringTime"
    },
    {
      "title": {
        "fi": "Pölytys",
        "sv": "Pollination",
        "en": "Pollination"
      },
      "body": {},
      "predicate": "MX.reproductionPollination"
    },
    {
      "title": {
        "fi": "Itiöpesäkkeet",
        "sv": "Sporangium",
        "en": "Sporangium"
      },
      "body": {},
      "predicate": "MX.descriptionSporangiumAndAsexualReproduction"
    },
    {
      "title": {
        "fi": "Itiöt",
        "sv": "Sporer",
        "en": "Spores"
      },
      "body": {},
      "predicate": "MX.descriptionSpore"
    },
    {
      "title": {
        "fi": "Hedelmä ja siemen",
        "sv": "Frukt och frö",
        "en": "Fruit and seed"
      },
      "body": {
        "fi": "<p>Hedelmä on alle 10 mm pitkä, monisiemeninen marja, kypsänä punainen.</p>"
      },
      "predicate": "MX.descriptionFruitAndSeed"
    },
    {
      "title": {
        "fi": "Elinympäristö",
        "sv": "Habitat",
        "en": "Habitat"
      },
      "body": {
        "fi": "<p>Kuivahkoissa lehdoissa ja jyrkänteiden juurella.</p>"
      },
      "predicate": "MX.habitat"
    },
    {
      "title": {
        "fi": "Kasvualusta",
        "sv": "Växtunderlag",
        "en": "Substrate"
      },
      "body": {
        "fi": "<p>Kalkinsuosija.</p>"
      },
      "predicate": "MX.habitatSubstrate"
    },
    {
      "title": {
        "fi": "Levinneisyys Suomessa",
        "sv": "Utbredning i Finland",
        "en": "Distribution in Finland"
      },
      "body": {
        "fi": "<p>Itä- ja Pohjois-Suomessa. Puuttuu Inarin Lapista.</p>"
      },
      "predicate": "MX.distributionFinland"
    },
    {
      "title": {
        "sv": "Bevarande i Finland",
        "fi": "Uhanalaisuus Suomessa",
        "en": "Conservation status in Finland"
      },
      "body": {},
