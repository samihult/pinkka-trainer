  "description": [
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "Monivuotinen, löyhästi mätästävä tai yksittäisversoinen ruoho."
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {
        "fi": "20–40 cm."
      },
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "Juurakko pitkä; varret pystyjä ja jäykkiä; tyvitupet tumman punertavia, usein ripsilaitaisia.&#xa0;"
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Juuri",
        "sv": "Rot",
        "en": "Root"
      },
      "body": {},
      "predicate": "MX.descriptionRoot"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "Lehdet vartta lyhyempiä, 2–4 mm leveitä, jäykkiä, sinivihreitä."
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Kukka",
        "sv": "Blomma",
        "en": "Flower"
      },
      "body": {
        "fi": "Kukinto 3–10 cm, pysty ja harsu, 3–6-tähkäinen; tähkät 10–25 mm; alimman tähkän tukilehti tavallisesti ei kukinnon pituinen. Latvatähkä ei paljon muita isompi, toisinaan kokonaan hedekukkainen. Hedekukka kolmiheteinen, emikukka kolmiluottinen, pullakon ympäröimä. Tähkäsuomut tavallisesti pullakkoa lyhyempiä, suippoja, harvoin lyhyelti otakärkisiä. Pullakot 2–3 mm, tylppiä, lähes odattomia.&#xa0;"
      },
      "predicate": "MX.descriptionFlower"
    },
    {
      "title": {
        "fi": "Kukinta-aika",
        "sv": "Blomningstid",
        "en": "Flowering time"
      },
      "body": {
        "fi": "Kukkii keskikesällä (VI–VII)."
      },
      "predicate": "MX.reproductionFloweringTime"
    },
    {
      "title": {
        "fi": "Pölytys",
        "sv": "Pollination",
        "en": "Pollination"
      },
      "body": {
        "fi": "Tuulipölytteinen."
      },
      "predicate": "MX.reproductionPollination"
    },
    {
      "title": {
        "fi": "Hedelmä ja siemen",
        "sv": "Frukt och frö",
        "en": "Fruit and seed"
      },
      "body": {
        "fi": "Hedelmä on pullakon sisällä kypsyvä pähkylä."
      },
      "predicate": "MX.descriptionFruitAndSeed"
    },
    {
      "title": {
        "fi": "Kasvualusta",
        "sv": "Växtunderlag",
        "en": "Substrate"
      },
      "body": {},
      "predicate": "MX.habitatSubstrate"
    },
    {
      "title": {
        "fi": "Elinympäristö",
        "sv": "Habitat",
        "en": "Habitat"
      },
      "body": {
        "fi": "Ohutturpeisilla, minerotrofisilla soilla, purojen varsilla, hiekkaisilla rannoilla, koskikallioilla, etenkin tunturikoivikoissa ja paljakan alaosissa."
      },
      "predicate": "MX.habitat"
