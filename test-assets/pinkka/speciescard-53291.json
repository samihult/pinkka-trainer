  },
  "scientificName": "Abietinella abietina",
  "distributionMapFinland": null,
  "alternativeVernacularNames": {},
  "description": [
    {
      "title": {
        "sv": "Beskrivning",
        "fi": "Yleiskuvaus",
        "en": "Description"
      },
      "body": {
        "en": "<p>Pleurocarpous moss.</p>"
      },
      "predicate": "MX.descriptionText"
    },
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "<p>Keskikokoinen sulkahaarainen lehtisammal.</p>"
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {
        "fi": "<p>4–8 cm.</p>",
        "en": "<p>4–8 cm.</p>"
      },
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Sekovarsi",
        "sv": "Thallus",
        "en": "Thallus"
      },
      "body": {},
      "predicate": "MX.descriptionThallus"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "<p>Varret alustanmyötäiset tai vinosti pystyt, kasvavat löyhinä peitteinä, säännöllisen sulkahaaraiset, parafyllien peitossa.</p>",
        "en": "<p>Shoots once-pinnate, with short, unequal, tapered, branches.</p>"
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Lehdet leveät, himmeän kellanruskeat, teräväkärkiset, keskisuoni hyvin vahva.</p>",
        "en": "<p>Stem leaves oval, longitudinally ridged, erect when dry, erect-spreading when moist, with a broad base and tapering to a long tip. Branch leaves much smaller than stem leaves, concave, and broadly oval to spear-shaped, blunt or sharp tip, erect when dry, erect-spreading when moist.</p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Itiöpesäkkeet",
        "sv": "Sporangium",
        "en": "Sporangium"
      },
      "body": {
        "fi": "<p>Itiöpesäkkeet harvinaisia.</p>",
        "en": "<p>Capsules rare.</p>"
      },
      "predicate": "MX.descriptionSporangiumAndAsexualReproduction"
    },
    {
      "title": {
        "fi": "Lisääntyminen",
        "sv": "Reproduktion",
        "en": "Reproduction"
      },
      "body": {},
      "predicate": "MX.reproduction"
    },
    {
      "title": {
        "fi": "Kasvualusta",
        "sv": "Växtunderlag",
        "en": "Substrate"
      },
      "body": {
        "fi": "<p>Maassa, etenkin kalkkipitoisilla alustoilla.</p>",
        "en": "<p>On rich base-rich soil.</p>"
      },
      "predicate": "MX.habitatSubstrate"
    },
    {
      "title": {
        "fi": "Elinympäristö",
        "sv": "Habitat",
        "en": "Habitat"
      },
      "body": {
        "fi": "<p>Kuivilla kedoilla, lehtokallioilla, hiekkamaalla, kiviaidoilla, muureilla, lehtipuiden tyvellä.</p>",
        "en": "<p>Road banks, dry forests and meadows, ock ledges.</p>"
      },
      "predicate": "MX.habitat"
    },
    {
      "title": {
        "fi": "Levinneisyys Suomessa",
        "sv": "Utbredning i Finland",
        "en": "Distribution in Finland"
      },
      "body": {
        "fi": "<p>Yleinen Etelä- ja Keski-Suomessa, harvinaistuu pohjoista kohti.</p>",
        "en": "<p>Common in southern and central Finland, becoming rare towards the north.</p>"
      },
      "predicate": "MX.distributionFinland"
    },
    {
      "title": {
        "fi": "Lisätiedot",
        "sv": "Tilläggsuppgifter",
        "en": "Additional information"
      },
      "body": {},
      "predicate": "MX.miscText"
    }
