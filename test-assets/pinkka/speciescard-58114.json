  "description": [
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "<p>Kausivihanta puu.</p>"
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {
        "fi": "<p>10–20 m korkea.</p>"
      },
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "<p>Vahvarunkoinen ja -haarainen, oksat kaljut. Nuoret oksat maitiaisnesteellisiä.</p>"
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Juuri",
        "sv": "Rot",
        "en": "Root"
      },
      "body": {},
      "predicate": "MX.descriptionRoot"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Lehdet vastakkain, lapa 8–15 cm, alta vaaleanvihreä, kourasuoninen, 3–5-liuskainen, liuskat isohampaisia.</p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Kukka",
        "sv": "Blomma",
        "en": "Flower"
      },
      "body": {
        "fi": "<p>Kukkii lehtien puhjetessa. Kukinto pysty, huiskilomainen. Kukat pieniä, verhiö ja teriö 5-lehtisiä, teriö keltainen. Heteitä 8, emejä 2.</p>",
        "sv": "<p>Blommar vid bladsprickning. Blomställning upprätt, kvastlik. Blommor små, foder- och kronblad 5-taliga, kronblad gula. 8 ståndare, 2 pistiller.</p>"
      },
      "predicate": "MX.descriptionFlower"
    },
    {
      "title": {
        "fi": "Kukinta-aika",
        "sv": "Blomningstid",
        "en": "Flowering time"
      },
      "body": {
        "sv": "<p>Blommar i början av sommaren.</p>",
        "fi": "<p>Kukkii alkukesällä (V–VI).</p>"
      },
      "predicate": "MX.reproductionFloweringTime"
    },
    {
      "title": {
        "fi": "Pölytys",
        "sv": "Pollination",
        "en": "Pollination"
      },
      "body": {},
      "predicate": "MX.reproductionPollination"
    },
    {
      "title": {
        "fi": "Käpy",
        "sv": "Kotte",
        "en": "Cone"
      },
      "body": {},
      "predicate": "MX.descriptionCone"
    },
    {
      "title": {
        "fi": "Hedelmä ja siemen",
        "sv": "Frukt och frö",
        "en": "Fruit and seed"
      },
      "body": {
        "fi": "<p>Hedelmä 2-siipinen, 2-lohkoinen lohkohedelmä. Siipien välinen kulma tylppä.</p>",
        "sv": "<p>Frukt en 2-vingad klyvfrukt. Fruktens vingar bildar en trubbig vinkel.</p>"
      },
      "predicate": "MX.descriptionFruitAndSeed"
    },
    {
      "title": {
        "fi": "Elinympäristö",
        "sv": "Habitat",
        "en": "Habitat"
      },
      "body": {
        "fi": "<p>Lehdoissa, yleinen piha- ja puistopuu.</p>",
        "sv": "<p>I lundar, allmän som gårds- och parkträd.</p>"
      },
      "predicate": "MX.habitat"
    },
    {
      "title": {
