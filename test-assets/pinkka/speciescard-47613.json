    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Lehdet ovat kierteisesti, pariliuskaisia–lehdykkäisiä, usein toistamiseen liuskoittuneita, harvahampaisia, kaljuja, möyheitä, liuskat kapeita ja jokseenkin tasasoukkia.</p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Juuri",
        "sv": "Rot",
        "en": "Root"
      },
      "body": {},
