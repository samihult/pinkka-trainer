  "scientificName": "Sceptridium multifidum",
  "distributionMapFinland": null,
  "alternativeVernacularNames": {},
  "description": [
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "<p>Monivuotisesta maavarresta kasvava kellan- tai tummanvihreä lehti. Lehti jakautunut aivan tyveltään lavaksi ja itiöpesäkkeistöksi, 5–25 cm korkea.</p>"
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {},
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Elinympäristö",
        "sv": "Habitat",
        "en": "Habitat"
      },
      "body": {
        "fi": "<p>Kuivilla hiekkaisilla kedoilla, niityillä ja pientareilla.</p>"
      },
      "predicate": "MX.habitat"
    },
    {
      "title": {
        "fi": "Alkuperä ja yleislevinneisyys",
        "sv": "Ursprung och helhetsutbredning",
        "en": "Origin and general distribution"
      },
      "body": {
        "fi": "<p>Euraasian ja Pohjois-Amerikka (puuttuu laajoilta alueilta Keskilännestä ja Etelävaltioista).</p>"
      },
      "predicate": "MX.originAndDistributionText"
    }
  ],
