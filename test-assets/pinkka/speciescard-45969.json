    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Lehtiruoti noin neljännes lavan pituudesta, mustanruskea; lehtilapa tasasoukka, parilehdykkäinen, keskiranka mustanruskea, kapealti vaaleanpalteinen; lehdykät&#xa0; tummanvihreitä, pitkulaisia ja tylppiä, hieman hammaslaitaisia.</p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Kukka",
        "sv": "Blomma",
        "en": "Flower"
      },
      "body": {
        "fi": "<p>Itiöpesäkeryhmät ovat lehtilavan alapinnalla lehtisuonten sivussa, kapeanpuikeita tai tasasoukkia, katesuomuisia.</p>"
      },
      "predicate": "MX.descriptionFlower"
    },
    {
      "title": {
        "fi": "Hedelmä ja siemen",
        "sv": "Frukt och frö",
        "en": "Fruit and seed"
      },
      "body": {
        "fi": "<p>Itiökasvi.</p>"
      },
      "predicate": "MX.descriptionFruitAndSeed"
    },
    {
      "title": {
        "fi": "Itiöpesäkkeet",
        "sv": "Sporangium",
        "en": "Sporangium"
      },
      "body": {
        "fi": "<p>Itiöpesäkeryhmät lehtilavan alapinnalla lehtisuonten sivussa, kapeanpuikeita tai tasasoukkia, katesuomuisia.</p>"
