        "fi": "Yleiskuvaus",
        "sv": "Beskrivning",
        "en": "Description"
      },
      "body": {},
      "predicate": "MX.descriptionText"
    },
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "<p>Kaksivuotinen, murskattuna pahanhajuinen ruoho.</p>"
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
      "title": {
        "fi": "Koko",
        "sv": "Storlek",
        "en": "Size"
      },
      "body": {
        "fi": "<p>50–150 cm.</p>"
      },
      "predicate": "MX.descriptionOrganismSize"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "<p>Varsi kalju, alaosasta punatäpläinen.</p>"
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Lehdet kolmiomaiset, jopa 50 cm, kaksi tai kolme kertaa parilehdykkäiset; lehdykät 1–2 cm, kolmiomaisia tai pitkulaisia, liuskaisia tai sahalaitaisia. </p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
    {
      "title": {
        "fi": "Juuri",
        "sv": "Rot",
        "en": "Root"
      },
      "body": {},
      "predicate": "MX.descriptionRoot"
    },
    {
      "title": {
        "fi": "Kukka",
        "sv": "Blomma",
        "en": "Flower"
      },
      "body": {
        "fi": "<p>Kukinto kerrannaissarja; pääsarja tavallisesti suojuksellinen; suojuksen lehdet kapean kolmiomaisia tai suikeita, alaviistoja; pikkusarjoissa 3–6 toispuolista, usein tyvestä yhdiskasvuista suojuksen lehteä. Kukat kaksineuvoisia; verhiö, teriö ja hetiö viisilehtisiä; teriö valkoinen.</p>"
      },
      "predicate": "MX.descriptionFlower"
    },
    {
      "title": {
        "fi": "Kukinta-aika",
        "sv": "Blomningstid",
        "en": "Flowering time"
      },
      "body": {
        "fi": "<p>Kukkii keski- ja syyskesällä (VII–VIII).</p>"
      },
      "predicate": "MX.reproductionFloweringTime"
    },
    {
      "title": {
        "fi": "Pölytys",
        "sv": "Pollination",
        "en": "Pollination"
      },
      "body": {
        "fi": "<p>Hyönteispölytteinen.</p>"
      },
      "predicate": "MX.reproductionPollination"
    },
    {
      "title": {
        "fi": "Hedelmä ja siemen",
        "sv": "Frukt och frö",
        "en": "Fruit and seed"
      },
      "body": {
        "fi": "<p>Hedelmä kaksilohkoinen lohkohedelmä, 2,5–3,5 mm, lähes pallomainen, sivuilta litteä; harjut paksuja, kyhmyisiä. </p>"
      },
      "predicate": "MX.descriptionFruitAndSeed"
    },
    {
      "title": {
        "fi": "Käpy",
