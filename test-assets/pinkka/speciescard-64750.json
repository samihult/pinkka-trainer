    },
    {
      "title": {
        "fi": "Kukinta-aika",
        "sv": "Blomningstid",
        "en": "Flowering time"
      },
      "body": {
        "fi": "<p>Kukkii alkukesällä (V–VI).</p>",
        "sv": "<p>Blommar i början av sommaren (maj-juni).</p>"
      },
      "predicate": "MX.reproductionFloweringTime"
    },
    {
