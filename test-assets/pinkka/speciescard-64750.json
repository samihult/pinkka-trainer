        "en": "Habitat"
      },
      "body": {
        "fi": "<p>Lehdoissa, puronvarsilla, rantametsissä, metsänreunoissa, myös koristepuu.</p>",
        "sv": "<p>Åkrar, trädgårdar, berg och ruderatmark.</p>"
      },
