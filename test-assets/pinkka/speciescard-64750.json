        "sv": "Växtunderlag",
        "en": "Substrate"
      },
      "body": {
        "fi": "<p>Tuomi viihtyy runsasravinteisessa, multavassa maassa.</p>",
        "sv": "<p>Häggen trivs på mullaktig näringsrik mark.</p>"
      },
