      "title": {
        "fi": "Lisätiedot",
        "sv": "Tilläggsuppgifter",
        "en": "Additional information"
      },
      "body": {
        "fi": "<p>Tuoreet lehdot, kosteat lehdot.</p>"
      },
      "predicate": "MX.miscText"
    },
    {
      "title": {
        "fi": "Varsi",
        "sv": "Stam",
        "en": "Stem"
      },
      "body": {
        "fi": "<p>Puun kuori on tummanharmaa. Haarat ovat siirottavia tai riippuvia. Oksat ovat punaruskeita, kiiltäviä, sileitä.</p>"
      },
      "predicate": "MX.descriptionStem"
    },
    {
      "title": {
        "fi": "Lehti",
        "sv": "Blad",
        "en": "Leaf"
      },
      "body": {
        "fi": "<p>Lehtilapa (5–7 cm) on ehyt, soikea, pyöreä- tai herttatyvinen, suippokärkinen, terävästi sahalaitainen, himmeä.</p>"
      },
      "predicate": "MX.descriptionLeaf"
    },
