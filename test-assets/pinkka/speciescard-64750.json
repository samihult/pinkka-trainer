  "description": [
    {
      "title": {
        "fi": "Yleiskuvaus",
        "sv": "Beskrivning",
        "en": "Description"
      },
      "body": {
        "sv": "<p>Buske eller ett litet träd, 2-15 m högt. Bark mörkgrå. Grenar utspärrande eller hängande. Grenar rödbruna, glänsande, med slät bark. Bladskiva 5-7 cm, hel, elliptisk, rund- eller hjärtformad bas, vass spets, vasst tandad, matt.</p>"
      },
      "predicate": "MX.descriptionText"
    },
    {
      "title": {
        "fi": "Kasvumuoto",
        "sv": "Livsform",
        "en": "Growing form"
      },
      "body": {
        "fi": "<p>Pensas tai pieni puu.</p>"
      },
      "predicate": "MX.growthFormAndGrowthHabit"
    },
    {
